# Operator configuration — contains the home base address and credentials.
# Never commit. See DEC-035.
config/local.json
config/*.local.json

# Credentials and secrets
.env
.env.*
*.pem
*.key
credentials.json
token.json

# Cached external responses — may be large, and are reproducible evidence
# tied to one machine rather than shared source. See charter section 14.
cache/
data/raw/

# Local application outputs and dependencies
node_modules/
apps/*/node_modules/
apps/*/dist/
apps/*/build/
*.tsbuildinfo

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*~

# DEC-092. Local evidence written by the pipeline validation harness. Real
# retrieved business data — same reason cache/ is excluded, and it must never
# be committed.
apps/operator/.validation-data/

# Claude Code's own local permission allow-list — machine-specific, not
# project config. Same reasoning as .vscode//.idea/ above.
.claude/settings.local.json
